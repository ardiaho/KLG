{
  "mcpServers": {
    "zabap-mcp": {
      "command": "node",
      "args": [
        "--tls-min-v1.0",
        "--tls-max-v1.2",
        "<ZABAP_MCP_BIN>",
        "--transport=stdio",
        "--env-path=<CLIENT_REPO_ABS_PATH>/zabap.env"
      ],
      "env": { "TLS_REJECT_UNAUTHORIZED": "0" }
    }
  }
}
