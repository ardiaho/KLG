# SAP ABAP ADT MCP server — <CLIENT>
#
# The REAL env file lives at the PROJECT ROOT (<client-repo>/zabap.env), gitignored —
# NOT inside .mcp/. Copy this template up one level and fill in credentials:
#   cp .mcp/zabap.env.example ./zabap.env
# .mcp.json references it via --env-path=.../<client-repo>/zabap.env

SAP_URL=https://<host>:<port>
SAP_CLIENT=<NN>
SAP_LANGUAGE=EN

# Allow self-signed cert (on-prem/dev only — leave at 1/omit for a properly signed system)
TLS_REJECT_UNAUTHORIZED=0

SAP_AUTH_TYPE=basic
SAP_SYSTEM_TYPE=onprem
SAP_USERNAME=<your-sap-username>
SAP_PASSWORD=<your-sap-password>

# System context (required for on-prem create/update operations)
SAP_MASTER_SYSTEM=<SYSTEM>
SAP_RESPONSIBLE=<your-sap-username>

# Timeouts (ms)
SAP_TIMEOUT_DEFAULT=45000
SAP_TIMEOUT_CSRF=15000
SAP_TIMEOUT_LONG=60000
